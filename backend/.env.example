# Copy from repo root .env.example — backend reads DATABASE_URL + JWT_* + CORS_*
# See README.md § Manual Interventions if using local MySQL instead of Docker.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DATABASE_URL=mysql://helfy:helfy_dev_password@localhost:3306/helfy_ecommerce

JWT_ACCESS_SECRET=change_me_dev_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

LOG_LEVEL=debug
