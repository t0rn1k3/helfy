# =============================================================================
# Helfy eCommerce - Environment Variables
# =============================================================================
# Copy this file to .env (root, backend/, and frontend/ as appropriate) and
# fill in real values. Never commit .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (used by /backend/.env)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (matches docker-compose.yml defaults for local dev)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=helfy
DATABASE_PASSWORD=helfy_dev_password
DATABASE_NAME=helfy_ecommerce
DATABASE_URL=mysql://helfy:helfy_dev_password@localhost:3306/helfy_ecommerce

# JWT — generate strong secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_dev_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Frontend (used by /frontend/.env, Vite requires VITE_ prefix)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=Helfy
